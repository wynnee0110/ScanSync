# FastAPI backend configuration template.
# Copy to backend/.env for local development. NEVER commit the real file.
# In deployment, set these in the hosting provider's secret store, not in a file.

# --- Supabase (privileged) ---
SUPABASE_URL=https://xhzprnpnilcosunfaqaj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhoenBybnBuaWxjb3N1bmZhcWFqIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NzY5OTYyMCwiZXhwIjoyMTAzMjc1NjIwfQ.x7T1ETJXR4PtuJLW_48UW1VsS0HKK90Ya_KGBEJFuSA
SUPABASE_JWT_SECRET=EZOuuogUvDB/CQL++06IDaoefQrs9ogvkLoOdZCrGxGGoT2IDKw5/DqA54iOM4e7CKrCZVH9YRbp5LI/98LW4g==

# --- Google Drive ---
# The root folder the backend writes report folders into.
# Under the OAuth path this is created by the backend on first run; record the
# resulting ID here. The historically supplied folder ID is in docs/PROGRESS_REPORT.md.
GOOGLE_DRIVE_ROOT_FOLDER_ID=11ExxCW__8ROzle2Sfeda122SdDv5kQAK
# Authorization strategy: "oauth_user" (personal/consumer Drive) or
# "service_account" (Google Workspace Shared Drive only).
GOOGLE_DRIVE_AUTH_MODE=oauth_user

# --- oauth_user mode ---
# One designated organization account owns the report files and their storage quota.
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=replace-me-refresh-token

# --- service_account mode (Shared Drive only) ---
# Full JSON as a single-line string, or a path resolved only from a secret mount.
# A service account has no Drive storage quota and cannot own files in My Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# --- App ---
APP_ENV=development
LOG_LEVEL=info
# Comma-separated list of allowed origins for CORS (e.g., "http://localhost:3000,https://example.com")
# Use "*" to allow all origins (not recommended for production).
ALLOWED_ORIGINS=*
