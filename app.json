{
  "expo": {
    "name": "ScanSync",
    "slug": "attendance-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "scansync",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/Logo.png",
      "bundleIdentifier": "com.waynnee1.scansync",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/Logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.waynnee1.scansync"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111827",
          "image": "./assets/images/Logo.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attendance Manager to scan participant QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f727e7d-d075-442b-801f-20b6ad675e96"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6f727e7d-d075-442b-801f-20b6ad675e96"
    }
  }
}
