  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "expo start",
    "start": "expo start --go",
    "start:lan": "expo start --go --lan",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "backend": "PYTHONPATH=. backend/.venv/bin/uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint"
  },
  "private": true
